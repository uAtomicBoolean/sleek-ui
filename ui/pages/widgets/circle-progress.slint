import { UAppTheme } from "../../sleek-ui/app-theme.slint";
import { UTitle, UText, UCircleProgress } from "../../sleek-ui/widgets.slint";
import {
    DocTitle,
    DocDescription,
    WidgetPresentation,
    DocSection,
    DocCode,
} from "../../components/doc-widgets.slint";
import { PageBase } from "../../components/page-base.slint";
import { AppLogic } from "../../app-logic.slint";


export component CircleProgressPage inherits PageBase {
    UTitle {
        level: 3;
        text: "Circle progress";
    }

    DocDescription {
        text: "A circular progress indicator.";
    }

    DocSection {
        title: "Basic usage";
        description: @markdown("Define the current progress with the `progress` property and change its color using the `progress-color` property.");
    }

    WidgetPresentation {
        spacing: UAppTheme.spacing-base;
        UCircleProgress {
            progress: 40%;
        }

        UCircleProgress {
            progress-color: UAppTheme.warning.base;
            progress: 60%;
        }

        UCircleProgress {
            progress-color: UAppTheme.golden-purple.base;
            progress: 100%;
        }
    }

    DocCode {
        code: "UCircleProgress {\n    progress: 40%;\n}\n\nUCircleProgress {\n    progress-color: UAppTheme.warning.base;\n    progress: 60%;\n}\n\nUCircleProgress {\n    progress-color: UAppTheme.golden-purple.base;\n    progress: 100%;\n}";
    }

    DocSection {
        title: "Gap";
        description: @markdown(
			"Use the `gap-degree` property (between `0deg` and `295deg`) to open the circle, like a dashboard.\n"
			"Use the `gap-position` property (`top`, `bottom`, `left` or `right`) to choose where the gap is placed."
		);
    }

    WidgetPresentation {
        spacing: UAppTheme.spacing-base;
        UCircleProgress {
            gap-degree: 75deg;
            progress: 75%;
        }

        UCircleProgress {
            gap-degree: 90deg;
            gap-position: left;
            progress: 50%;
        }

        UCircleProgress {
            gap-degree: 120deg;
            gap-position: top;
            progress: 30%;
        }
    }

    DocCode {
        code: "UCircleProgress {\n    gap-degree: 75deg;\n    progress: 75%;\n}\n\nUCircleProgress {\n    gap-degree: 90deg;\n    gap-position: left;\n    progress: 50%;\n}";
    }

    DocSection {
        title: "Direction";
        description: @markdown("Use the `direction` property to choose whether the progress starts from the start (clockwise) or the end (counter-clockwise).");
    }

    WidgetPresentation {
        spacing: UAppTheme.spacing-base;
        UCircleProgress {
            direction: start;
            progress: 40%;
        }

        UCircleProgress {
            direction: end;
            progress: 40%;
        }
    }

    DocCode {
        code: "UCircleProgress {\n    direction: end;\n    progress: 40%;\n}";
    }

    DocSection {
        title: "Indeterminate progress";
        description: @markdown("Set the `indeterminate` property to `true` to set the progress in a loading state.");
    }

    WidgetPresentation {
        spacing: UAppTheme.spacing-base;
        UCircleProgress {
            indeterminate: true;
        }

        UCircleProgress {
            gap-degree: 75deg;
            indeterminate: true;
        }
    }

    DocCode {
        code: "UCircleProgress {\n    indeterminate: true;\n}";
    }

    DocSection {
        title: "Size, line width and content";
        description: @markdown(
			"You can manage the size of the progress with the `default-size` property and the thickness of the circle with the `line-width` property.\n"
			"Any child element is placed inside the circle, which can be used to display the progress' value."
		);
    }

    WidgetPresentation {
        spacing: UAppTheme.spacing-base;
        UCircleProgress {
            default-size: 60px;
            progress: 40%;
        }

        UCircleProgress {
            default-size: 120px;
            line-width: 12px;
            progress: 65%;
            UText {
                width: 100%;
                height: 100%;
                horizontal-alignment: center;
                vertical-alignment: center;
                font-size: UAppTheme.font-size-bigger;
                text: "\{round(parent.progress * 100)}%";
            }
        }
    }

    DocCode {
        code: "UCircleProgress {\n    default-size: 60px;\n    progress: 40%;\n}\n\nUCircleProgress {\n    default-size: 120px;\n    line-width: 12px;\n    progress: 65%;\n    UText {\n        width: 100%;\n        height: 100%;\n        horizontal-alignment: center;\n        vertical-alignment: center;\n        font-size: UAppTheme.font-size-bigger;\n        text: \"\\{round(parent.progress * 100)}%\";\n    }\n}";
    }
}
