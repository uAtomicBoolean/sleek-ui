import { UTitle } from "../../sleek-ui/widgets.slint";

import {
    DocDescription,
    DocSection,
} from "../../components/doc-widgets.slint";
import { PageBase } from "../../components/page-base.slint";


export component InteractiveBasePage inherits PageBase {
    UTitle {
        level: 3;
        text: "Interactive base";
    }

    DocDescription {
        text: "A widget that is used to build interactive widgets with an implementation of both TouchArea and FocusScope.";
    }

    DocSection {
        title: "Enabled and mouse cursor";
        description: @markdown("The `enabled` property enables/disables both the FocusScope and the TouchArea.");
    }

    DocSection {
        title: "TouchArea and FocusScope implementations";
        description: @markdown("All the properties and callbacks for both are availables in the `UInteractiveBase` widget.");
    }

    DocSection {
        title: "Background and border color animations";
        description: @markdown(
			"The `UInteractiveBase` widget has animated border color and background by default.\n"
			"You can override the animations manually or simply disable them with the `enable-animations` property."
		);
    }

    DocSection {
        title: "The has-tab-focus property";
        description: @markdown(
			"The `has-tab-focus` property allows you to know when a widget gains the focus from a tab navigation.\n"
			"This means that a widget can get the focus while this property keeps being false.\n"
			"In sleek-ui, this property is used to display the focus when navigating with tab, and to focus a widget without displaying the keyboard focus style."
		);
    }
}
