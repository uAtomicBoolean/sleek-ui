import { UAppTheme } from "../../sleek-ui/app-theme.slint";
import { UTitle, UScrollView } from "../../sleek-ui/widgets.slint";

import {
    DocTitle,
    DocDescription,
    WidgetPresentation,
    DocSection,
    DocCode,
} from "../../components/doc-widgets.slint";
import { PageBase } from "../../components/page-base.slint";
import { AppLogic } from "../../app-logic.slint";


export component ScrollviewPage inherits PageBase {
    UTitle {
        level: 3;
        text: "Scrollview";
    }

    DocDescription {
        text: "A scrollview with a custom look and feel.";
    }

    DocSection {
        title: "How to use";
        description: @markdown(
			"This widget works like a standard scrollview. It automatically computes the content's size "
			"unless you use a `for` loop. The standard properties of `Flickable` (content-*, interactive) "
			"are available on the widget."
		);
    }

    WidgetPresentation {
        Rectangle {
            width: 200px;
            height: 200px;
            border-width: 1px;
            border-color: UAppTheme.text;
            UScrollView {
                width: 200px;
                height: 200px;
                content-width: 400px;
                content-height: 400px;
                Rectangle {
                    width: 30px;
                    height: 30px;
                    x: 275px;
                    y: 250px;
                    background: blue;
                }

                Rectangle {
                    width: 30px;
                    height: 30px;
                    x: 175px;
                    y: 130px;
                    background: red;
                }

                Rectangle {
                    width: 30px;
                    height: 30px;
                    x: 25px;
                    y: 210px;
                    background: yellow;
                }

                Rectangle {
                    width: 30px;
                    height: 30px;
                    x: 98px;
                    y: 55px;
                    background: orange;
                }
            }
        }
    }

    DocCode {
        code: "UScrollView {\n    width: 200px;\n    height: 200px;\n    content-width: 400px;\n    content-height: 400px;\n    Rectangle {\n        width: 30px;\n        height: 30px;\n        x: 25px;\n        y: 210px;\n    }\n}";
    }

    DocSection {
        title: "Scrollbar area";
        description: @markdown(
			"By default, the scrollbars are drawn above the content. You can use the `scrollbar-area` "
			"property to get the length/width of the scrollbar."
		);
    }

    DocCode {
        code: "UScrollView {\n    VerticalLayout {\n        padding-right: parent.scrollbar-area;\n        // Your elements.\n    }\n}";
    }

    DocSection {
        title: "Scroll to and scroll by functions";
        description: @markdown(
			"Four functions let you scroll programmatically: `scroll-x-to(pos)` / `scroll-y-to(pos)` move to an "
			"absolute content position, while `scroll-x-by(delta)` / `scroll-y-by(delta)` move by a relative offset. "
			"All of them are clamped to the content bounds and animated."
		);
    }

    DocSection {
        title: "Keyboard navigation";
        description: @markdown(
			"When the widget is focused, `PageUp` / `PageDown` scroll vertically and `Home` / `End` jump to the top "
			"and bottom. Hold `Shift` to scroll horizontally instead. These movements are animated as well."
		);
    }
}
