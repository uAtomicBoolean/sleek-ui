import { UAppTheme } from "../app-theme.slint";
import { ProgressDirection } from "common/enums.slint";


export component ULineProgress inherits Rectangle {
    // Accessibility properties
    accessible-role: progress-indicator;
    accessible-value: indeterminate ? 0 : progress;
    accessible-value-minimum: 0;
    accessible-value-maximum: 100;
    accessible-orientation: orientation;
    // Regular properties
    in-out property <brush> progress-color: UAppTheme.primary.base;
    in property <length> default-size: 10px;
    in property <length> default-radius: UAppTheme.radius-round;
    in property <Orientation> orientation: horizontal;
    in property <ProgressDirection> direction: start;
    in-out property <percent> progress;
    in-out property <bool> indeterminate: false;
    // Position of the indeterminate bar's start along the track, as a ratio of the track's length.
    // The bar covers 30% of the track and goes completely out of it before coming back.
    private property <float> indeterminate-offset: indeterminate ? mod(animation-tick() / 1500ms, 1.3) - 0.3 : 0;
    private property <float> indeterminate-start: direction == ProgressDirection.end ? 0.7 - indeterminate-offset : indeterminate-offset;
    background: UAppTheme.color-fill-secondary;
    border-radius: default-radius;
    clip: true;
    height: default-size;
    width: default-size;
    if orientation == Orientation.horizontal: Rectangle {
        x: indeterminate ? root.width * root.indeterminate-start : direction == end ? root.width - self.width : 0;
        background: progress-color;
        border-radius: default-radius;
        width: indeterminate ? 30% : clamp(progress, 0%, 100%);
        animate width {
            easing: ease-in-out;
            duration: 350ms;
        }
    }
    if orientation == Orientation.vertical: Rectangle {
        y: indeterminate ? root.height * root.indeterminate-start : direction == end ? root.height - self.height : 0;
        background: progress-color;
        border-radius: default-radius;
        height: indeterminate ? 30% : clamp(progress, 0%, 100%);
        animate height {
            easing: ease-in-out;
            duration: 350ms;
        }
    }
}
