import { UIconButton } from "icon-button.slint";


export component UWindow inherits Window {
    icon: @image-url("../assets/icons/eye.svg");
    no-frame: true;
    resize-border-width: 2px;
    background: pink;
    init => {
        if self.no-frame {
            debug("Setting 'no-frame' to true will display the default window's decorations.");
        }
    }
    changed no-frame => {
        if self.no-frame {
            debug("Setting 'no-frame' to true will display the default window's decorations.");
        }
    }

    Rectangle {
        border-width: 2px;
        border-color: red;

        VerticalLayout {
            alignment: start;

            // Title bar
			Rectangle {
                background: white;

                HorizontalLayout {
                    cross-axis-alignment: center;
                    padding: 4px;
                    spacing: 8px;

                    Image {
                        source: root.icon;
                        width: 18px;
                        height: 18px;
                    }

                    Text {
                        text: root.title;
                    }

                    Rectangle {
                        horizontal-stretch: 2;
                    }

                    UIconButton {
                        icon: @image-url("../assets/icons/minus.svg");
                    }

                    UIconButton {
                        icon: @image-url("../assets/icons/x.svg");
                    }
                }
            }
        }

        @children
    }
}
